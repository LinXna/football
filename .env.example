GEMINI_API_KEY=your_gemini_api_key_here
# 可选：配置多个Key，支持逗号、分号或换行分隔；遇到429会自动轮换。
# GEMINI_API_KEYS=key_one,key_two,key_three

# 可选：OpenAI 备用供应商。Gemini 出现 429/5xx/网络故障时自动切换。
# 请使用你自己的 OpenAI Platform API Key；不要把 Key 写入前端代码或提交到 Git。
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_API_KEYS=key_one,key_two,key_three
# OPENAI_MODEL=gpt-5.6-luna

# 可选：供应商尝试顺序。也可以改为 openai,gemini。
# AI_PROVIDER_ORDER=gemini,openai
